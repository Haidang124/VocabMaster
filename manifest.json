{
  "manifest_version": 3,
  "name": "VocabMaster",
  "version": "1.0",
  "description": "VocabMaster - Master English vocabulary with highlighting, review, and spaced repetition",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "identity",
    "notifications",
    "tabs"
  ],
  "host_permissions": [
    "https://sheets.googleapis.com/*",
    "https://www.googleapis.com/*",
    "https://dictionary-api.eliaschen.dev/*"
  ],
  "web_accessible_resources": [
    {
      "resources": ["vocabmaster.json"],
      "matches": ["<all_urls>"]
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "css": ["content.css"]
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "VocabMaster"
  },
  "commands": {
    "highlight-word": {
      "suggested_key": {
        "default": "Alt+H"
      },
      "description": "Highlight selected word"
    }
  },
  "icons": {
    "16": "icons/VocabMaster.png",
    "48": "icons/VocabMaster.png",
    "128": "icons/VocabMaster.png"
  }
}
